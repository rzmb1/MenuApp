{
  "name": "kantine",
  "version": "0.4.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "cross-env JWT_DECODEONLY=true npm run mocha-tests",
    "test-ci": "cross-env JWT_DECODEONLY=true c8 --reporter text-summary --reporter cobertura mocha --exit --sort --recursive './tests-mocha' --reporter mocha-junit-reporter",
    "nodemon": "nodemon server.js",
    "mocha-tests": "docker stop Kantine_TeamA & docker run -d --name Kantine_TeamA -p 27017:27017 --rm mongo && c8 --reporter html --reporter text-summary mocha --exit --sort --recursive './tests-mocha' --reporter spec",
    "init-db": "docker stop Kantine_TeamA & docker run -d --name Kantine_TeamA -p 27017:27017 --rm mongo && node ./test-data/init.js",
    "start-db": "docker run -d --name Kantine_TeamA -p 27017:27017 --rm mongo",
    "stop-db": "docker stop Kantine_TeamA",
    "async-fileprocessing": "nodemon ./demo/async-backend/async-fileprocessing.js",
    "fillDemoData": "npm run init-db",
    "fill-demo-data": "node ./test-data/init.js",
    "generateMenuplans": "node ./test-data/callJsonGenerator.js",
    "createPredictionModel": "node ./menuplans/createPredictionModel.js",
    "lint": "eslint --ext .js --format gitlab ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/htl-villach/informatik/2023-5ahif/syp-bsd/TeamA.git"
  },
  "author": "Felix Reimüller, Thomas Fischer, Rubens Zambelli, David Weißensteiner, Justus Arndt",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/htl-villach/informatik/2023-5ahif/syp-bsd/TeamA/issues"
  },
  "homepage": "https://gitlab.com/htl-villach/informatik/2023-5ahif/syp-bsd/TeamA#readme",
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "@godaddy/terminus": "^4.12.1",
    "@joi/date": "^2.1.0",
    "@tensorflow/tfjs": "^4.13.0",
    "@types/jsonwebtoken": "^9.0.5",
    "express": "^4.18.1",
    "joi": "^17.7.0",
    "joi-objectid": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^7.0.4",
    "morgan": "^1.10.0",
    "seedrandom": "^3.0.5",
    "winston": "^3.9.0",
    "yargs": "^17.6.0"
  },
  "devDependencies": {
    "c8": "^8.0.1",
