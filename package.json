    "eslint": "^8.55.0",
    "eslint-formatter-gitlab": "^5.1.0",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.2.1",
    "nodemon": "^3.0.2",
    "superagent-defaults": "^0.1.14",
    "supertest": "^6.3.4"
  }
